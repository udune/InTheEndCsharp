<Window x:Class="CodingGuide.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="C# 오프라인 코딩 가이드" Width="1440" Height="920" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic" FontSize="13"
        Background="{StaticResource WindowBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 바 -->
        <Border Background="{StaticResource HeaderBrush}" Padding="18,11">
            <DockPanel>
                <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="C#" Foreground="#60A5FA" FontSize="18" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="오프라인 코딩 가이드" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="인터넷 없이 개념 · 레시피 · 오류 해결법 검색" Foreground="#94A3B8" FontSize="12"
                               VerticalAlignment="Bottom" Margin="14,0,0,2" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 검색 + 목차/결과 -->
            <DockPanel Background="{StaticResource PanelBrush}">
                <Border DockPanel.Dock="Top" Padding="14,14,14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="SearchBox" FontSize="15" Padding="34,8,30,8" VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource BorderBrush}" TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
                            <TextBlock Text="🔍" FontSize="14" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock x:Name="SearchPlaceholder" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="#94A3B8" FontSize="14"
                                       Text="무엇이든 물어보세요  예) 리스트 중복 제거, CS0103" />
                            <Button x:Name="ClearButton" Content="✕" HorizontalAlignment="Right" Width="26" Height="26" Margin="0,0,4,0"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource SubtleTextBrush}"
                                    Cursor="Hand" Visibility="Collapsed" Click="ClearButton_Click" ToolTip="검색어 지우기 (Esc)" />
                        </Grid>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="AskButton" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="AI에게 질문"
                                    Padding="12,4" IsEnabled="False" Click="AskButton_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="검색창의 질문을 로컬 AI에게 물어봅니다 (Ctrl+Enter)" />
                            <TextBlock x:Name="AiStatus" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock x:Name="ResultInfo" Margin="2,8,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Grid>
                    <TreeView x:Name="TocTree" BorderThickness="0" Padding="6,4" SelectedItemChanged="TocTree_SelectedItemChanged" />
                    <ListBox x:Name="ResultList" BorderThickness="0" Visibility="Collapsed" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ResultList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource TagBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource HeadingBrush}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Snippet}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- 오른쪽: 문서 + 예제 -->
            <Grid Grid.Column="2" x:Name="RightPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition x:Name="SplitterRow" Height="5" />
                    <RowDefinition x:Name="BottomRow" Height="300" MinHeight="0" />
                </Grid.RowDefinitions>

                <!-- 도구 모음 -->
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="◀ 이전" IsEnabled="False"
                                Click="BackButton_Click" ToolTip="이전 문서 (Alt+←)" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Content="■ 답변 중지" Margin="0,0,8,0"
                                    Visibility="Collapsed" Click="StopButton_Click" />
                            <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="▶ 예제 실행" IsEnabled="False"
                                    Click="RunButton_Click" ToolTip="이 문서의 학습 예제를 실행합니다 (F5)" />
                        </StackPanel>
                        <TextBlock x:Name="Breadcrumb" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <FlowDocumentScrollViewer x:Name="DocViewer" Grid.Row="1" Background="{StaticResource PanelBrush}"
                                          VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" x:Name="BottomSplitter" />

                <TabControl x:Name="BottomTabs" Grid.Row="3" BorderThickness="0,1,0,0" Padding="0">
                    <TabItem Header="  예제 코드  ">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" x:Name="SourceBar" Padding="8,5" Background="{StaticResource CodeBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="파일" VerticalAlignment="Center" Margin="2,0,8,0" Foreground="{StaticResource SubtleTextBrush}" />
                                    <ComboBox x:Name="SourcePicker" MinWidth="320" HorizontalAlignment="Left" SelectionChanged="SourcePicker_SelectionChanged" />
                                </DockPanel>
                            </Border>
                            <ae:TextEditor x:Name="CodeEditor" IsReadOnly="True" ShowLineNumbers="True" FontSize="13.5"
                                           FontFamily="D2Coding, Consolas, Malgun Gothic" SyntaxHighlighting="C#"
                                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="6" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="  실행 결과  " x:Name="OutputTab">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="10,5" Background="{StaticResource CodeBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="지우기" Padding="10,2"
                                            Click="ClearOutput_Click" />
                                    <TextBlock x:Name="RunStatus" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"
                                               Text="[▶ 예제 실행]을 누르면 Console 출력이 여기에 표시됩니다." />
                                </DockPanel>
                            </Border>
                            <TextBox x:Name="OutputBox" IsReadOnly="True" BorderThickness="0" Padding="10,8" FontSize="13.5"
                                     FontFamily="D2Coding, Consolas, Malgun Gothic" Background="#0F172A" Foreground="#E2E8F0"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
