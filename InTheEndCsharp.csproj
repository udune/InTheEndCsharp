<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- 하위 폴더의 별도 프로젝트(AsyncUI, APIApp 등)는 이 콘솔 프로젝트의 빌드 대상에서 제외한다.
         새 프로젝트를 하위 폴더에 추가하면 여기에 "폴더명\**"을 ;로 이어 붙인다. -->
    <PropertyGroup>
      <SubProjectDirs>AsyncUI\**;APIApp\**;APIBackend\**;Tests\**</SubProjectDirs>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="$(SubProjectDirs)" />
      <EmbeddedResource Remove="$(SubProjectDirs)" />
      <None Remove="$(SubProjectDirs)" />
      <Content Remove="$(SubProjectDirs)" />
    </ItemGroup>
    <ItemGroup>
      <None Update="의존성주입\appsettings.json" Link="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Castle.Core" Version="5.2.1" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

</Project>
